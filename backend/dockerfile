FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --omit=dev

COPY . .

EXPOSE 4000

# prisma generate + migrate deploy tournent au démarrage du conteneur (pas au
# build) : prisma.config.ts exige DATABASE_URL, qui n'existe qu'à l'exécution
# (fourni par docker-compose), pas pendant le build de l'image. Bénéfice
# secondaire : le moteur Prisma généré correspond alors exactement à l'OS
# d'exécution (linux-musl), pas à celui de la machine qui a buildé l'image.
CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy && node index.js"]
