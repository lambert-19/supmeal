generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CookbookRole {
  editor
  commentator
  reader
}

enum MealSlot {
  breakfast
  lunch
  dinner
}

enum VerificationTokenType {
  email_verification
  password_reset
}

model User {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  passwordHash    String
  tokenVersion    Int       @default(0) // incrémenté au changement de mot de passe : invalide tous les JWT déjà émis
  emailVerified   Boolean   @default(false)
  lastSeenAt      DateTime? // mis à jour quand la dernière socket de l'utilisateur se déconnecte (présence en ligne)
  dietaryRegime   String    @default("none")
  allergies       String[]  @default([])
  favoriteCuisine String    @default("none")
  defaultServings Int       @default(4)
  connectedGoogle Boolean   @default(false)
  connectedGithub Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipes             Recipe[]
  cookbooks           Cookbook[]           @relation("CookbookOwner")
  memberships         CookbookMember[]
  planningEntries     PlanningEntry[]
  comments            Comment[]
  messages            Message[]
  verificationTokens  VerificationToken[]
  messageReceipts     MessageReceipt[]
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  createdAt DateTime              @default(now())

  @@index([userId, type])
}

model Recipe {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String
  prepTime   Int
  cookTime   Int
  servings   Int
  tags       String[]  @default([])
  images     String[]  @default([])
  source     String    @default("")
  favorite   Boolean   @default(false)
  cookbookId String?
  cookbook   Cookbook? @relation(fields: [cookbookId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  ingredients     Ingredient[]
  steps           Step[]
  comments        Comment[]
  planningEntries PlanningEntry[]

  @@index([ownerId])
  @@index([cookbookId])
}

model Ingredient {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity String @default("")
  unit     String @default("")
  position Int

  @@index([recipeId])
}

model Step {
  id       String @id @default(cuid())
  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  text     String
  position Int

  @@index([recipeId])
}

model Cookbook {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("CookbookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  CookbookMember[]
  recipes  Recipe[]
  messages Message[]

  @@index([ownerId])
}

model CookbookMember {
  id                   String       @id @default(cuid())
  cookbookId           String
  cookbook             Cookbook     @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                String
  name                 String
  role                 CookbookRole
  inviteTokenHash      String?      @unique
  inviteTokenExpiresAt DateTime?

  @@unique([cookbookId, email])
  @@index([userId])
}

model PlanningEntry {
  id       String   @id @default(cuid())
  ownerId  String
  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  date     String
  mealSlot MealSlot
  recipeId String?
  recipe   Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([ownerId, date, mealSlot])
  @@index([ownerId, date])
}

model Comment {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([recipeId])
}

model Message {
  id         String   @id @default(cuid())
  cookbookId String
  cookbook   Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text       String   @default("") // vide pour un message uniquement composé d'un sticker
  imageUrl   String? // sticker/image envoyé dans le chat (même pipeline d'upload que les recettes)
  createdAt  DateTime @default(now())

  receipts MessageReceipt[]

  @@index([cookbookId])
}

// Un accusé par (message, destinataire) — jamais créé pour l'auteur lui-même.
// deliveredAt : la donnée a atteint le client (fetch ou socket "message:new").
// readAt : en plus, l'onglet du destinataire était visible à ce moment-là
// (Page Visibility API) — distinction volontaire pour permettre les deux
// coches (livré vs lu) plutôt qu'un seul état binaire.
model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime?
  readAt      DateTime?

  @@unique([messageId, userId])
  @@index([messageId])
}
