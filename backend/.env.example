DATABASE_URL="postgresql://user:password@localhost:5432/supmeal?schema=public"

NODE_ENV=development
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_NAME=supmeal_token
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# SMTP optionnel : si non renseigné, les emails sont simulés (loggés en console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SUPMEAL <no-reply@supmeal.fr>"

# OAuth2 optionnel : si les identifiants d'un fournisseur sont vides, le bouton
# correspondant redirige vers le frontend avec oauthError=not_configured au
# lieu de planter. URI de redirection à déclarer côté fournisseur :
# ${BACKEND_URL}/auth/oauth/google/callback (Google Cloud Console > Identifiants)
# ${BACKEND_URL}/auth/oauth/github/callback (GitHub > Settings > Developer settings > OAuth Apps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
